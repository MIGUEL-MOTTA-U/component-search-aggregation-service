NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CACHE_DRIVER=memory
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=1800
PUBLIC_RATE_LIMIT_MAX=120
PUBLIC_RATE_LIMIT_WINDOW=1 minute
SOURCE_RATE_LIMIT_MS=1000
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36
# Set to true to bypass robots.txt checks during local development/testing:
IGNORE_ROBOTS_TXT=false


